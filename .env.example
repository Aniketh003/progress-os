# -----------------------------------------------------------------------------
# ProgressOS Environment Configuration
# -----------------------------------------------------------------------------

# 1. NextAuth / Auth.js (Generate random secret with: openssl rand -base64 32)
AUTH_SECRET=your-random-base64-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# 2. Google OAuth 2.0 Credentials (From Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI in Google Console:
# - Local: http://localhost:3000/api/auth/callback/google
# - Production: https://progress-os-eight-blond.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# 3. MongoDB Atlas (M0 Free Sandbox Cluster)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=progressos
